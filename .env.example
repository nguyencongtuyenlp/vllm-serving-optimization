# vLLM Server Configuration
# Copy this file to .env and customize as needed

# Model Selection
# Recommended for 4GB VRAM (choose one):
# - Qwen/Qwen2.5-0.5B-Instruct (safest, unquantized)
# - Qwen/Qwen2.5-1.5B-Instruct-AWQ (if available)
# - TheBloke/TinyLlama-1.1B-Chat-v1.0-GPTQ (if available)
MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct

# Quantization (leave empty for none, or use: awq, gptq, squeezellm)
QUANTIZATION=

# vLLM Performance Tuning
# Max context length (lower = less VRAM)
MAX_MODEL_LEN=2048

# GPU memory utilization (0.0-1.0, recommend 0.85 for 4GB)
GPU_MEMORY_UTILIZATION=0.85

# Data type (auto, float16, bfloat16)
DTYPE=auto

# HuggingFace Token (only needed for gated models)
HF_TOKEN=

# HuggingFace cache directory
HF_HOME=~/.cache/huggingface
